/* Day 20 - style.css - No <style> tag needed here! */

* { box-sizing: border-box; }

body {
  font-family: Arial;
  margin: 0;
  background: #f5f5f5;
}

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: black;
  color: white;
  padding: 15px 20px;
}

.navbar a {
  color: white;
  text-decoration: none;
  margin-left: 15px;
}

.logo { margin: 0; }

.hero {
  text-align: center;
  background: white;
  padding: 30px;
  margin: 20px;
  border-radius: 10px;
  border: 2px solid black;
}

.hero img {
  width: 200px;
  height: 200px;
  border-radius: 50%; /* circle photo! */
  border: 3px solid blue;
  object-fit: cover;
}

.hero button {
  background: blue;
  color: white;
  padding: 12px 25px;
  border: none;
  border-radius: 8px;
  font-size: 16px;
}

.note { color: grey; font-size: 12px; }

.cards {
  display: flex;
  gap: 15px;
  padding: 20px;
}

.card {
  flex: 1; /* flex-grow! - Day 19 lesson */
  background: white;
  padding: 15px;
  text-align: center;
  border-radius: 10px;
  border: 2px solid black;
}

.card img {
  width: 100%;
  height: 150px;
  border-radius: 8px;
  object-fit: cover;
}

.footer {
  text-align: center;
  background: black;
  color: white;
  padding: 15px;
}

/* Media Query - Day 18 lesson */
@media (max-width: 600px) {
  .cards { flex-direction: column; }
  .navbar { flex-direction: column; gap: 10px; }
}
